FROM maven:3.9-eclipse-temurin-8 AS java8
FROM causaltrace-multilang-runner:local
USER root
COPY --from=java8 /opt/java/openjdk /opt/java/openjdk8
ENV JAVA_HOME=/opt/java/openjdk8 PATH="/opt/java/openjdk8/bin:${PATH}"
WORKDIR /opt/upstream-build
COPY . .
RUN mvn -B -Dmaven.repo.local=/opt/maven-repository -Dmaven.test.failure.ignore=true test && chmod -R a+rX /opt/maven-repository
USER runner
WORKDIR /workspace
